<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.draftroom.serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app/draftroom</string>
        <string>serve</string>
        <string>-addr</string>
        <string>:8083</string>
    </array>

    <!-- The binary in the checkout is built by `make draftroom`, which does
         not bake paths the way `make install` does, so it is told where to
         look. DRAFTROOM_OWNER_ID is what makes the board yours: without it
         every team reads as a flat $200 with no keepers deducted. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DRAFTROOM_OWNER_ID</key>
        <string>243501760939814912</string>
        <key>DRAFTROOM_CONFIG_DIR</key>
        <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app/internal/draft/data</string>
        <key>DRAFTROOM_DATA_DIR</key>
        <string>/Users/adamwieberg/adori/fantasy_sports_data</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/draftroom.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/draftroom.error.log</string>
</dict>
</plist>
