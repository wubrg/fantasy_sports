<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.draftroom-jeff.serve</string>

    <!-- A valuation board for Jeff, who drafts in his own league somewhere
         else. Not a view of anyone's team here: there is no owner id below,
         because he has no roster in this league and a board keyed to nobody is
         exactly the generic one he wants. `-keepers none` opens it on a full
         pool -- the default is this league's draft night, which deducts our
         keeper money and would quietly understate every price for his draft.
         `-leans jeff` is his own set, since reads he sets are written back to
         whichever set the board was opened with. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app/draftroom</string>
        <string>serve</string>
        <string>-addr</string>
        <string>:8086</string>
        <string>-leans</string>
        <string>jeff</string>
        <string>-keepers</string>
        <string>none</string>
    </array>

    <!-- DRAFTROOM_OWNER_ID is a name here, not a Sleeper id: Jeff has no
         roster in this league, so it matches nobody and the board reads every
         team as a flat budget with no keepers deducted -- which is the generic
         board he wants. It still earns its place, because it is what the saved
         shortlist is keyed on: without it his teams would land in the unscoped
         saved-teams.json that the fallback keeps for a lone board. The prices
         still come from this league's scoring and roster shape, so they are
         indicative for his draft rather than exact. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DRAFTROOM_OWNER_ID</key>
        <string>jeff</string>
        <key>DRAFTROOM_CONFIG_DIR</key>
        <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app/internal/draft/data</string>
        <key>DRAFTROOM_DATA_DIR</key>
        <string>/Users/adamwieberg/adori/fantasy_sports_data</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/adamwieberg/adori/fantasy_sports/league_home/app</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/draftroom-jeff.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/draftroom-jeff.error.log</string>
</dict>
</plist>
