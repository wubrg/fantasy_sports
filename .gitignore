# Go build artifacts
canton/app/canton
canton/app/cantonctl
edge/app/edgectl
league_home/app/leaguectl
league_home/app/leaguebot
league_home/app/leagueweb
league_home/app/draftroom

# Local SQLite DB (regenerate with: cantonctl import ../data/canton_data.json)
canton/data/canton.db
canton/data/canton.db-shm
canton/data/canton.db-wal

# Draft room source data. Raw vendor exports and their normalized form are
# subscriber content (The Athletic / Ciely, FantasyPoints, Late-Round,
# Peaked) and must not be redistributed via this repo. The extractor code,
# the manifest, and the league's own rulings are tracked; the data is not.
league_home/app/internal/draft/data/raw/
league_home/app/internal/draft/data/normalized/

# macOS + Python cruft in the draft room tools
.DS_Store
__pycache__/
*.pyc
.venv/

# nflverse cache: ~185 MB of open NFL data, fully regenerable with
#   python3 edge/model/ingest/nflverse.py
# The provenance that matters (source URLs, fetch dates, checksums) is copied
# into the generated artifacts, which ARE tracked — so nothing is lost by
# leaving the raw files out.
edge/model/data/raw/

# Wagering framework source captures. These are browser print-to-PDF exports of
# Gemini share pages: ~118 MB total, and URPS-v3.pdf alone is 74 MB, close to
# GitHub's 100 MB per-file limit. Their text layer is unusable anyway (subsetted
# web fonts with no /ToUnicode maps), which is why the transcribed Markdown in
# edge/docs/frameworks/ is the tracked artifact. Keep the PDFs locally as the
# originals; each transcript records its source share URL.
/*.pdf

# Agent tooling local state: Claude Code's worktrees/settings and the
# Cowork-imported placeholder. Local to a checkout, not repo content.
.claude/
AGENTS.md

# Go build temp files (canton/app) and FUSE sidecar files (canton/data) that
# otherwise leave git status permanently noisy. See docs/backlog.md H5.
*-go-tmp-umask
.fuse_hidden*
